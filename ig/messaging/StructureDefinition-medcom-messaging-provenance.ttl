           fhir:Extension.valueCanonical [
             fhir:value "http://medcomfhir.dk/ig/messaging/ActorDefinition/ProducerActor" ;
             fhir:link <http://medcomfhir.dk/ig/messaging/ActorDefinition/ProducerActor>
           ]
         ] ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/obligation" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "Provenance.entity.what.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "If previous message is EDIFACT or OIOXML, this element must be expressed as [lokationsnummer]#[brevid] from the EDIFACT or OIOXML message." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Shall contain the message header id of messages given as input to the activity if the previous message is not a fhir message" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

